<h2>清算运行清单</h2><div class="tablebox"><table><thead><tr><th>留档编号</th><th>原件包</th><th>原清算批次</th><th>补扫认回</th><th>仍有争议</th><th>落档时间 UTC</th><th>耗时 ms</th></tr></thead><tbody>{% for item in history %}<tr><td><a href="/clearing/appeal?key={{ item.key }}">{{ item.key[:18] }}</a></td><td>{{ item.source }}</td><td>{% if item.parent %}<a href="/clearing/appeal?key={{ item.parent }}"><code>{{ item.parent[:12] }}</code></a>{% else %}—{% endif %}</td><td>{% if item.reclaimed %}{{ item.reclaimed|length }} 笔 · ¥{{ '%.2f'|format(item.reclaimed|sum(attribute='cents')/100) }}{% else %}—{% endif %}</td><td>{% if item.disputed %}{{ item.disputed|map(attribute='receipt')|join('、') }}{% else %}—{% endif %}</td><td>{{ item.created_utc }}</td><td>{{ item.elapsed_ms }}</td></tr>{% else %}<tr><td colspan="7">先运行一次清算。</td></tr>{% endfor %}</tbody></table></div>
